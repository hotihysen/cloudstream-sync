<?xml version="1.0" encoding="utf-8"?>
<!-- Flimmer: weicher Übergang (leicht hereinzoomen und einblenden, abbremsend) -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:shareInterpolator="true">
    <scale android:duration="280" android:fromXScale="0.96" android:toXScale="1.0"
        android:fromYScale="0.96" android:toYScale="1.0" android:pivotX="50%" android:pivotY="50%" />
    <alpha android:duration="240" android:fromAlpha="0.0" android:toAlpha="1.0" />
</set>
